# SSH 连接信息
VPS_HOST=example.com
VPS_SSH_USER=root
VPS_SSH_PORT=22

# 服务器部署信息。首次运行会自动初始化这些路径、用户和服务。
# 管理员密码不会写在此文件中，而是在首次部署时交互输入。
VPS_BASE_DIR=/opt/pixiu-library
VPS_APP_USER=pixiu
VPS_APP_GROUP=pixiu
VPS_SERVICE_NAME=pixiu-library
VPS_DATA_DIR=/var/lib/pixiu-library
VPS_ENV_FILE=/etc/pixiu-library.env
VPS_HEALTHCHECK_URL=http://127.0.0.1:3000/
